# Copia este archivo a .env y completa los valores

# Proveedor de modelos — cualquier endpoint compatible con la API OpenAI.
# Se aceptan tanto LLM_* (genérico) como OMNIROUTE_* (compatibilidad histórica).
# Ejemplos:
#   OpenRouter : https://openrouter.ai/api/v1
#   OpenAI     : https://api.openai.com/v1
#   Anthropic  : https://api.anthropic.com/v1
#   Groq       : https://api.groq.com/openai/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Gemini     : https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama     : http://localhost:11434/v1        (sin API key)
#   LM Studio  : http://localhost:1234/v1         (sin API key)
LLM_URL=https://openrouter.ai/api/v1
LLM_API_KEY=tu_api_key_aqui
LLM_MODEL=openai/gpt-4o-mini

# (Compatibilidad histórica; equivale a LLM_*)
#OMNIROUTE_URL=https://openrouter.ai/api/v1
#OMNIROUTE_API_KEY=tu_api_key_aqui
#OMNIROUTE_MODEL=poolside/laguna-s-2.1:free

# ANTHROPIC (para CLI claude, no para la app)
#ANTHROPIC_BASE_URL=http://localhost:20128/v1
#ANTHROPIC_AUTH_TOKEN=tu_anthropic_token_aqui
#ANTHROPIC_MODEL=auto/coding:free[1m]
#ANTHROPIC_SMALL_FAST_MODEL=auto/coding:free[1m]
#CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# TTS Providers - Fish Audio
FISH_API_KEY=tu_fish_audio_api_key_aqui
FISH_REFERENCE_ID=tu_fish_audio_reference_id_aqui
FISH_MODEL=s2.1-pro-free

# TTS Providers - OpenAI
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# TTS Providers - ElevenLabs
ELEVENLABS_API_KEY=tu_elevenlabs_api_key_aqui
ELEVENLABS_VOICE_ID=tu_voice_id_aqui
ELEVENLABS_MODEL=eleven_multilingual_v2

# Configuración general
AUTO_TTS=false